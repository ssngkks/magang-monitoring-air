#pragma once
// ============================================================
// TEMPLATE KREDENSIAL (audit.md §4)
// Copy file ini jadi "secrets.h" (folder yang sama), isi data asli.
// secrets.h sudah di-.gitignore-in -> aman dari ke-commit ke Git.
// JANGAN isi kredensial asli di file .h.example ini.
// ============================================================

// --- WiFi lokal (SATU jaringan dengan laptop server) ---
#define WIFI_SSID       "nama-wifi-kalian"
#define WIFI_PASSWORD   "password-wifi-kalian"

// --- Identitas unik per unit fisik ( beda per unit! ) ---
// KODE_NODE dipakai node_sensor (ESP32 #1), GATEWAY_ID dipakai gateway (ESP32 #2).
// Nilai HARUS SAMA PERSIS dengan kode_node yang didaftarkan di dashboard.
#define KODE_NODE   "ESP32-NODE-01"
#define GATEWAY_ID  "ESP32-GW-01"

// --- Shared device key prototipe LAN (audit.md §7) ---
// SAMA untuk semua unit, dan HARUS SAMA dengan DEVICE_KEY di file .env Laravel.
// Di server hanya hash-nya yang disimpan (kolom nodes.api_token_hash).
#define DEVICE_KEY  "prototipe-shared-key-ganti-ini"

// --- Server Laravel lokal (laptop) ---
// Pakai IP laptop + DHCP reservation di router agar stabil (gratis, tanpa domain).
// Contoh LAN murni: HOST "192.168.1.10", PORT 8000, URL "http://192.168.1.10:8000/api/sensor/store"
#define LOCAL_SERVER_HOST "192.168.1.10"
#define LOCAL_SERVER_PORT 8000
#define LOCAL_SERVER_URL  "http://192.168.1.10:8000/api/sensor/store"

// Endpoint manifest OTA via Laravel (dipakai OtaUpdater di gateway).
// Query ?device= diisi otomatis per unit (KODE_NODE / GATEWAY_ID).
#define OTA_MANIFEST_URL  "http://192.168.1.10:8000/api/firmware/ota/check?device=ESP32-NODE-01"

